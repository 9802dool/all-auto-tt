# Leave Supabase empty to run the local demo database (4 dealers, 24 parts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL used in messages, feeds, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123

# Required in production. Local demo falls back to a development-only secret.
SESSION_SECRET=

# Optional analytics. Scripts render only when these are set.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=

# Optional email. Without this, messages stay in the admin outbox.
RESEND_API_KEY=
EMAIL_FROM="ALL AUTO TT <parts@allautott.com>"

# Protects /api/cron/maintenance
CRON_SECRET=

# Shown in the README and used when promoting a profile to admin in Supabase.
ADMIN_EMAIL=admin@allautott.com
