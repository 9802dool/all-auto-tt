# Leave this empty on your computer. The site then uses data/db.json
# with 4 sample dealers and 45 sample parts.
# On Vercel, this is filled in when you create a Blob store and connect it
# to the project. See the README, "Connect the free file store".
BLOB_READ_WRITE_TOKEN=

# Public site URL used in messages, feeds, and the sitemap.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123

# Required in production. Local demo falls back to a development-only secret.
SESSION_SECRET=

# Optional analytics. Scripts render only when these are set.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=

# Optional email. Without this, messages stay in the admin outbox.
RESEND_API_KEY=
EMAIL_FROM="ALL AUTO TT <parts@allautott.com>"

# Protects /api/cron/maintenance
CRON_SECRET=

# The email that becomes an admin when that person signs up.
ADMIN_EMAIL=allautott@gmail.com
